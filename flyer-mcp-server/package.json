{
  "name": "flyer-mcp-server",
  "version": "1.0.0",
  "description": "MCP server to edit and export the JACK12 flyer (editor/ doc.json + Playwright export)",
  "type": "module",
  "main": "dist/index.js",
  "bin": { "flyer-mcp-server": "dist/index.js" },
  "scripts": {
    "seed": "tsx scripts/seed.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "md:export": "tsx scripts/md.ts export",
    "md:import": "tsx scripts/md.ts import",
    "test:client": "node scripts/test-client.mjs"
  },
  "engines": { "node": ">=18" },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
